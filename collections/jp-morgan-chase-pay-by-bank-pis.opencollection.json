            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "<!-- theme: warning-->\n> Deprecated\n>\n> Sunset: 30 May 2026\n- This request allows the PSU to consent to J.P. Morgan accessing their\naccount information at a particular `Provider`."
        },
        {
          "info": {
            "name": "Send Authorized Token Issued by Provider",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apigateway.jpmorgan.com/tsapi/v1/aisp/authorize",
