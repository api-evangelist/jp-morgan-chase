              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "<!-- theme: warning-->\n> Deprecated\n>\n> Sunset: 30 May 2026\n- Following the PSUs authorization and confirmation of information sharing with their provider, the provider issues a token\n  that permits access to the PSUs data. \n- This token must be transmitted to J.P. Morgan to complete the account information\n  request and digitally sign the request payload."
        },
        {
          "info": {
            "name": "Request for Account Information",
            "type": "http"
          },
          "http": {
            "method": "POST",
