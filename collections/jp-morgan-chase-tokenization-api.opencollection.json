              {
                "name": "tokenRequestorId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "token-reference-id",
                "value": "",
                "type": "path",
                "description": "Reference identifier for a specific token."
              }
            ]
          },
          "docs": "Request information about a token."
        },
        {
          "info": {
            "name": "Request token details",
